# ---- Database (Supabase) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- AI (Groq primary, Gemini fallback) ----
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# ---- Instagram / Threads (Meta) ----
IG_USER_ID=                  # also accepted: INSTAGRAM_USER_ID, INSTAGRAM_ACCOUNT_ID
INSTAGRAM_ACCESS_TOKEN=      # falls back to META_ACCESS_TOKEN
META_ACCESS_TOKEN=
THREADS_USER_ID=             # defaults to IG_USER_ID
THREADS_ACCESS_TOKEN=        # defaults to META_ACCESS_TOKEN

# ---- Telegram admin notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Deployment ----
RENDER_EXTERNAL_URL=https://cloud-rights-monitor.onrender.com   # public base URL Meta uses to fetch cards
CRON_SECRET=                 # recommended: protects /ingest-feeds, /publish-queue, /rescore-queue, /preview/*
PUBLISH_BATCH_SIZE=4

# ---- Look & feel ----
BRAND_NAME=HUMAN RIGHTS AGGREGATOR
BRAND_HANDLE=@human.rights.aggregator
ALLOW_AI_FALLBACK_IMAGES=false   # true = generate synthetic photos when no real photo exists (not recommended)
